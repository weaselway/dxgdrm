# kbuild output. Note these patterns also match dotfiles: gitignore globs are
# not shell globs, so *.o covers .module-common.o and .*.cmd covers the
# double-dotted ..module-common.o.cmd that kbuild emits for it.
*.o
*.ko
*.mod
*.mod.c
*.symvers
*.order
.*.cmd
.tmp_versions/
/.claude

# nix build output (GC root for the prepared kernel tree)
/result

# build-kernel-headers.sh output (kernel tree, toolchain).
/build/
